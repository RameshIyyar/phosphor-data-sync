foreground = quiet
socket = l:TCP_NODELAY=1
socket = r:TCP_NODELAY=1
debug = 3

[local_bmc]
client = no
accept = @BMC0_STUNNEL_PORT@
connect = @LOCAL_HOST_IP@:@BMC0_RSYNC_PORT@
cert = /etc/phosphor-data-sync/certs/bmc0.crt
key  = /etc/phosphor-data-sync/certs/bmc0.key
CAfile = /etc/phosphor-data-sync/certs/ca.crt
verify = 2

[sibling_bmc]
client = yes
accept = @LOCAL_HOST_IP@:@BMC1_RSYNC_PORT@
connect = <sibling_bmc_ip>:@BMC1_STUNNEL_PORT@
cert = /etc/phosphor-data-sync/certs/bmc0.crt
key  = /etc/phosphor-data-sync/certs/bmc0.key
CAfile = /etc/phosphor-data-sync/certs/ca.crt
verify = 2
